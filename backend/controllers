// Compares two user's games and returns list of games they have in common, with playtimes and icons included.
// Returns JSON object with list of games in common, playtime, and icons for each game

const compareGames = async (req, res) => {
    try {
        const steamid1 = req.params.steamid1;
        const steamid2 = req.params.steamid2;

        // 1.) Check cache for both users' owned games. If not in cache, fetch from Steam API and store in cache.
        let user1_games = myCache.get(`ownedGames_${steamid1}`);
        let user2_games = myCache.get(`ownedGames_${steamid2}`);

        console.log(`[Cache] user1 (${steamid1}):`, user1_games ? 'HIT' : 'MISS');
        console.log(`[Cache] user2 (${steamid2}):`, user2_games ? 'HIT' : 'MISS');

        if (!user1_games || !user2_games) {
            console.log('[API] Cache miss — fetching from Steam API...');
            // Fetch both users' games in parallel to avoid unnecessary waiting
            const [res1, res2] = await Promise.all([
                fetch(`https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=${STEAM_API_KEY}&steamid=${steamid1}&include_appinfo=true`),
                fetch(`https://api.steampowered.com/IPlayerService/GetOwnedGames/v1/?key=${STEAM_API_KEY}&steamid=${steamid2}&include_appinfo=true`)
            ]);
            const data1 = await res1.json();
            const data2 = await res2.json();
            user1_games = data1.response.games;
            user2_games = data2.response.games;
            myCache.set(`ownedGames_${steamid1}`, user1_games);
            myCache.set(`ownedGames_${steamid2}`, user2_games);
            console.log('[API] Games fetched and stored in cache.');
        }

        // 2.) Compare the two lists of games to find common games. Use a hash map for efficient lookup.
        // Build a map of user1's games keyed by appid for O(1) lookup
        const user1_games_map = {};
        for (let i = 0; i < user1_games.length; i++) {
            user1_games_map[user1_games[i].appid] = user1_games[i];
        }

        const common_games = []; // Array to store common games with name, playtime for both users, and icon
        for (let i = 0; i < user2_games.length; i++) {
            if (user1_games_map[user2_games[i].appid]) {
                common_games.push({
                    name: user2_games[i].name,
                    playtime_user1: user1_games_map[user2_games[i].appid].playtime_forever,
                    playtime_user2: user2_games[i].playtime_forever,
                    icon: `https://media.steampowered.com/steamcommunity/public/images/apps/${user2_games[i].appid}/${user2_games[i].img_icon_url}.jpg`
                });
            }
        }

        // Send back response as JSON object
        res.status(200).json({common_games});
        
    } catch (error) {
        res.status(500).send({message: "Error comparing games"});
    }
}

// Export the controller functions to be used in routes

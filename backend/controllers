// Steam uses query parameters, so headers aren't needed for authentication.
// API key is queried in their API calls.

const STEAM_API_KEY = process.env.API_KEY;
const NodeCache = require( "node-cache" );
const myCache = new NodeCache({stdTTL: 3600, checkperiod: 600}); // Cache for 1 hour, check every 10 minutes


// User input steamid, get profile picture and name from steam user
// RETURNS JSON object with profile picture and name
// GET https://partner.steam-api.com/ISteamUser/GetPlayerSummaries/v2/

const getProfileInformation = async (req, res) => {
    try {
            // 1. Correctly get the steamid from req.params
            const { steamid } = req.params; // brackets since steamid is a varialbe, not a string. It can be anything.
            const uri = `https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v2/?key=${STEAM_API_KEY}&steamids=${steamid}`;
            const response = await fetch(uri); 
            const data = await response.json();

            // 2. Parse the data to get the info you need
            const profile_picture = data.response.players[0].avatarfull;
            const profile_name = data.response.players[0].personaname;
            const profile_url = data.response.players[0].profileurl;

            // 3. Send only ONE response back with the data, being a JSON object containing profile name and profile picture
            res.status(200).json({profile_picture, profile_name, profile_url});

        } catch (error){
            res.status(500).send({message: "Error fetching profile information"});
        }
}

